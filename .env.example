# Copy to backend/.env (or export) and adjust. Every variable is optional: the defaults run
# fully locally with no API key (faster-whisper + llama.cpp) plus free edge-tts voices.

# --- provider selection ---------------------------------------------------
SAWT_STT=whisper            # whisper (local) | openai_stt (Groq/OpenAI Whisper) | deepgram | fake
SAWT_LLM=llamacpp           # llamacpp | openai_compat | scripted
SAWT_TTS=edge               # edge | elevenlabs | fake

# --- local STT (faster-whisper) --------------------------------------------
SAWT_WHISPER_MODEL=small    # tiny | base | small | medium | large-v3 (base is unusable for Arabic)
SAWT_WHISPER_COMPUTE_TYPE=int8

# --- hosted Whisper (uses SAWT_OPENAI_BASE_URL / SAWT_OPENAI_API_KEY below) -----
SAWT_OPENAI_STT_MODEL=whisper-large-v3-turbo

# --- hosted streaming STT ---------------------------------------------------
SAWT_DEEPGRAM_API_KEY=
SAWT_DEEPGRAM_MODEL=nova-3
SAWT_DEEPGRAM_LANGUAGE=multi   # "multi" does not cover Arabic; use "ar" for Arabic-only lines

# --- local LLM (llama-cpp-python, GGUF) -------------------------------------
SAWT_LLAMACPP_MODEL_PATH=../.local/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
SAWT_LLAMACPP_THREADS=

# --- any OpenAI-compatible endpoint -----------------------------------------
# Groq:   https://api.groq.com/openai/v1                          openai/gpt-oss-20b (measured)
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai  gemini-2.5-flash
# Ollama: http://localhost:11434/v1                               qwen2.5:7b
SAWT_OPENAI_BASE_URL=https://api.groq.com/openai/v1
SAWT_OPENAI_API_KEY=
SAWT_OPENAI_MODEL=openai/gpt-oss-20b
SAWT_OPENAI_REASONING_EFFORT=low   # only sent to gpt-oss models

# --- hosted TTS --------------------------------------------------------------
SAWT_ELEVENLABS_API_KEY=            # required only when SAWT_TTS=elevenlabs
SAWT_ELEVENLABS_MODEL=eleven_flash_v2_5   # or eleven_multilingual_v2 (higher quality, slower)
SAWT_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # shared by ar/fr/en unless overridden below
SAWT_ELEVENLABS_VOICE_ID_AR=
SAWT_ELEVENLABS_VOICE_ID_FR=
SAWT_ELEVENLABS_VOICE_ID_EN=

# --- turn taking ------------------------------------------------------------
SAWT_VAD_END_SILENCE_MS=550   # endpointing window: lower = snappier, higher = fewer cut-offs
SAWT_BARGE_IN_MIN_MS=180      # speech needed to interrupt the agent while it talks

# --- misc -------------------------------------------------------------------
SAWT_CLINIC_TODAY=            # pin the clinic's clock (YYYY-MM-DD), e.g. for demos
SAWT_METRICS_PATH=data/metrics.sqlite
SAWT_CORS_ORIGINS=["http://localhost:3000"]
